# This is an example for required ENV vars.
# Don't forget to rename file and to replace the "changeMe".
# Run "source .env.local".
export JOBS_SERVICE_DATABASE_HOST="localhost"
export JOBS_SERVICE_DATABASE_PORT=5432
export JOBS_SERVICE_DATABASE_USER="tracker_service"
export JOBS_SERVICE_DATABASE_PW="changeMe"
export JOBS_SERVICE_DATABASE_NAME="tracker_service"
export JOBS_SERVICE_DATABASE_URI=postgres://${JOBS_SERVICE_DATABASE_USER}:${JOBS_SERVICE_DATABASE_PW}@${JOBS_SERVICE_DATABASE_HOST}:${JOBS_SERVICE_DATABASE_PORT}/${JOBS_SERVICE_DATABASE_NAME}?sslmode=disable
