# This is an example for required ENV vars.
# Run "source .env.example".
export TRACKER_SERVICE_HOST=localhost
export TRACKER_SERVICE_PORT=8080
export TRACKER_SERVICE_URI=${TRACKER_SERVICE_HOST}:${TRACKER_SERVICE_PORT}
export TRACKER_SERVICE_DATABASE_HOST="localhost"
export TRACKER_SERVICE_DATABASE_PORT=5432
export TRACKER_SERVICE_DATABASE_USER="tracker_service"
export TRACKER_SERVICE_DATABASE_PW="postgreslocal"
export TRACKER_SERVICE_DATABASE_NAME="tracker_service"
export TRACKER_SERVICE_DATABASE_URI=postgres://${TRACKER_SERVICE_DATABASE_USER}:${TRACKER_SERVICE_DATABASE_PW}@${TRACKER_SERVICE_DATABASE_HOST}:${TRACKER_SERVICE_DATABASE_PORT}/${TRACKER_SERVICE_DATABASE_NAME}?sslmode=disable
