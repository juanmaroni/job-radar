# This is an example for required ENV vars.
# Don't forget to rename file and to replace the "changeMe".
TRACKER_SERVICE_HOST=tracker
TRACKER_SERVICE_PORT=8080
TRACKER_SERVICE_URI=tracker:8080
TRACKER_SERVICE_DATABASE_HOST=postgres
TRACKER_SERVICE_DATABASE_PORT=5432
TRACKER_SERVICE_DATABASE_USER=changeMe
TRACKER_SERVICE_DATABASE_PW=changeMe
TRACKER_SERVICE_DATABASE_NAME=tracker_service
TRACKER_SERVICE_DATABASE_URI=postgres://changeMe:changeMe@postgres:5432/tracker_service?sslmode=disable
TRACKER_SERVICE_REDIS_HOST=redis_tracker
TRACKER_SERVICE_REDIS_PORT=6379
TRACKER_SERVICE_REDIS_TTL=30
