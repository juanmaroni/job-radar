# This is an example for required ENV vars.
# Don't forget to rename file and to replace the "changeMe".
TRACKER_SERVICE_HOST=tracker
TRACKER_SERVICE_PORT=8080
TRACKER_SERVICE_URI=tracker:8080
TRACKER_SERVICE_DATABASE_HOST=postgres
TRACKER_SERVICE_DATABASE_PORT=5432
TRACKER_SERVICE_DATABASE_USER=changeMe
TRACKER_SERVICE_DATABASE_PW=changeMe
TRACKER_SERVICE_DATABASE_NAME=tracker_service
TRACKER_SERVICE_DATABASE_URI=postgres://changeMe:changeMe@postgres:5432/tracker_service?sslmode=disable
TRACKER_SERVICE_REDIS_HOST=redis_tracker
TRACKER_SERVICE_REDIS_PORT=6379
TRACKER_SERVICE_REDIS_TTL=30
TRACKER_SERVICE_MATCHING_HOST="matching:50051"

MATCHING_SERVICE_GRPC_PORT=":50051"
MATCHING_SERVICE_PROFILE_KEYWORDS="Kafka,gRPC,PostgreSQL,Redis,Docker,React,Redpanda,protobuf,microservices"
MATCHING_SERVICE_KAFKA_BROKER="redpanda:9092"

INGESTION_SERVICE_KAFKA_BROKER="redpanda:9092"
INGESTION_SERVICE_INTERVAL_SECONDS=300

JOBS_SERVICE_HOST=jobs
JOBS_SERVICE_PORT=8081
JOBS_SERVICE_URI=jobs:8081
JOBS_SERVICE_DATABASE_HOST=postgres
JOBS_SERVICE_DATABASE_PORT=5432
JOBS_SERVICE_DATABASE_USER=changeMe
JOBS_SERVICE_DATABASE_PW=changeMe
JOBS_SERVICE_DATABASE_NAME=jobs_service
JOBS_SERVICE_DATABASE_URI=postgres://changeMe:changeMe@postgres:5432/jobs_service?sslmode=disable
JOBS_SERVICE_KAFKA_BROKER="redpanda:9092"
